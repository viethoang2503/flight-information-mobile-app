<?xml version="1.0" encoding="utf-8"?>
<!-- Floating bottom bar, drawn on top of the real blur (Android 12+). The navy tint and the
     white gloss are pre-mixed into one gradient, so the bar costs one layer instead of two. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/glass_bar_bottom"
        android:startColor="@color/glass_bar_top" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
    <corners android:radius="@dimen/nav_bar_radius" />
</shape>
