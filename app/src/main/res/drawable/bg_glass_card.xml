<?xml version="1.0" encoding="utf-8"?>
<!-- Faux glass: translucent white, brighter at the top-left like a light reflection, with a thin rim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/glass_fill_bottom"
        android:startColor="@color/glass_fill_top" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
    <corners android:radius="@dimen/glass_radius" />
</shape>
