<?xml version="1.0" encoding="utf-8"?>
<!-- Below Android 12 there is no blur: a near-opaque fill keeps the glass readable over the content. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_bar_fallback" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
    <corners android:radius="@dimen/nav_bar_radius" />
</shape>
