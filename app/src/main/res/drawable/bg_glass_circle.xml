<?xml version="1.0" encoding="utf-8"?>
<!-- Round glass button behind toolbar icons: a 44dp circle inside the 48x56dp action slot. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_ripple">
    <item>
        <inset
            android:insetLeft="2dp"
            android:insetTop="6dp"
            android:insetRight="2dp"
            android:insetBottom="6dp">
            <shape android:shape="oval">
                <gradient
                    android:angle="270"
                    android:endColor="@color/glass_fill_bottom"
                    android:startColor="@color/glass_fill_top" />
                <stroke
                    android:width="1dp"
                    android:color="@color/glass_stroke" />
            </shape>
        </inset>
    </item>
</ripple>
