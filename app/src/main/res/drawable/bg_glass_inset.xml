<?xml version="1.0" encoding="utf-8"?>
<!-- Darker well inside a glass card, used for the raw METAR text (tappable, so it has a ripple). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_inset" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
