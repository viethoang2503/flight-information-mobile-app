<?xml version="1.0" encoding="utf-8"?>
<!-- Main call-to-action: glossy blue, lighter at the top. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_ripple">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/brand_primary"
                android:startColor="@color/brand_primary_light" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
            <corners android:radius="@dimen/button_radius" />
        </shape>
    </item>
</ripple>
