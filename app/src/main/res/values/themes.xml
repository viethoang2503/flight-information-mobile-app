<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Liquid Glass night theme. Dark only: the glass look depends on the dark blue backdrop. -->
    <style name="Theme.FlightInfo" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand_primary_light</item>
        <item name="colorPrimaryVariant">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/brand_link</item>
        <item name="colorSecondaryVariant">@color/brand_primary_light</item>
        <item name="colorOnSecondary">@color/brand_navy</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/brand_link</item>
        <item name="colorControlHighlight">@color/glass_ripple</item>
        <item name="android:colorBackground">@color/background</item>
        <!-- The window draws the one and only full-screen background (avoids overdraw).
             Transparent system bars let the same gradient show under them. -->
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background_bottom</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="textInputStyle">@style/Widget.FlightInfo.TextInput</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.FlightInfo.Dialog</item>
        <item name="snackbarStyle">@style/Widget.FlightInfo.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.FlightInfo.Snackbar.Text</item>
        <item name="snackbarButtonStyle">@style/Widget.FlightInfo.Snackbar.Button</item>
    </style>

    <!-- Dialogs (e.g. the list preferences in Settings) on the dark blue surface -->
    <style name="ThemeOverlay.FlightInfo.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorPrimary">@color/brand_link</item>
        <item name="colorSecondary">@color/brand_link</item>
        <item name="colorAccent">@color/brand_link</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Transparent toolbar over the gradient; its icons sit on round glass buttons. -->
    <style name="Widget.FlightInfo.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@null</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="titleTextAppearance">@style/TextAppearance.FlightInfo.ToolbarTitle</item>
        <item name="android:theme">@style/ThemeOverlay.FlightInfo.Toolbar</item>
    </style>

    <style name="ThemeOverlay.FlightInfo.Toolbar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="actionButtonStyle">@style/Widget.FlightInfo.ActionButton</item>
        <item name="actionOverflowButtonStyle">@style/Widget.FlightInfo.ActionButton.Overflow</item>
        <item name="toolbarNavigationButtonStyle">@style/Widget.FlightInfo.ToolbarNavigationButton</item>
        <item name="colorControlNormal">@color/white</item>
    </style>

    <style name="Widget.FlightInfo.ActionButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:background">@drawable/bg_glass_circle</item>
    </style>

    <style name="Widget.FlightInfo.ActionButton.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:background">@drawable/bg_glass_circle</item>
    </style>

    <style name="Widget.FlightInfo.ToolbarNavigationButton" parent="Widget.AppCompat.Toolbar.Button.Navigation">
        <item name="android:background">@drawable/bg_glass_circle</item>
    </style>

    <style name="TextAppearance.FlightInfo.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Departure-board look for flight numbers and times -->
    <style name="TextAppearance.FlightInfo.Code" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_code</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
