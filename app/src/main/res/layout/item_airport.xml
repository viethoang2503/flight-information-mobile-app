<?xml version="1.0" encoding="utf-8"?>
<!-- One airport as a glass card (ripple clipped to the rounded shape) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FlightInfo.Glass.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_m"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/airport_code"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.FlightInfo.Code"
        android:textColor="@color/brand_link"
        android:textSize="20sp"
        tools:text="HAN" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/airport_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Hà Nội · Việt Nam" />

        <TextView
            android:id="@+id/airport_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/text_caption"
            tools:text="Noi Bai International Airport" />
    </LinearLayout>

    <TextView
        android:id="@+id/airport_default"
        style="@style/Widget.FlightInfo.StatusChip"
        android:layout_marginStart="@dimen/space_s"
        android:text="@string/label_default_airport"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
