<?xml version="1.0" encoding="utf-8"?>
<!-- Plain row (no card background) to keep overdraw low in a long list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_m"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_m"
    android:paddingBottom="@dimen/space_s">

    <TextView
        android:id="@+id/airport_code"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.FlightInfo.Code"
        android:textColor="?attr/colorPrimary"
        android:textSize="20sp"
        tools:text="HAN" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/airport_city"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            tools:text="Hà Nội · Việt Nam" />

        <TextView
            android:id="@+id/airport_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/text_caption"
            tools:text="Noi Bai International Airport" />
    </LinearLayout>

    <TextView
        android:id="@+id/airport_default"
        style="@style/Widget.FlightInfo.StatusChip"
        android:layout_marginStart="@dimen/space_s"
        android:text="@string/label_default_airport"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
