<?xml version="1.0" encoding="utf-8"?>
<!-- One flight row: used by Recent searches, the airport board and My Flights.
     Glass card whose ripple is clipped to the rounded shape by bg_glass_card_clickable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FlightInfo.Glass.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_m"
    android:paddingTop="14dp"
    android:paddingEnd="@dimen/space_m"
    android:paddingBottom="14dp">

    <com.android.volley.toolbox.NetworkImageView
        android:id="@+id/flight_logo"
        style="@style/Widget.FlightInfo.Logo"
        android:layout_width="@dimen/logo_size"
        android:layout_height="@dimen/logo_size" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/flight_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FlightInfo.Code"
            tools:text="VN215" />

        <TextView
            android:id="@+id/flight_airline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/text_caption"
            tools:text="Vietnam Airlines" />

        <TextView
            android:id="@+id/flight_route"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/text_body"
            tools:text="HAN → SGN" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/flight_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FlightInfo.Code"
            tools:text="11:35" />

        <TextView
            android:id="@+id/flight_time_old"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone"
            tools:text="11:00"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/flight_status"
            style="@style/Widget.FlightInfo.StatusChip"
            android:layout_marginTop="6dp"
            tools:text="On time" />
    </LinearLayout>
</LinearLayout>
