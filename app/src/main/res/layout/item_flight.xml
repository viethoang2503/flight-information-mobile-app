<?xml version="1.0" encoding="utf-8"?>
<!-- One flight row: used by Recent searches, the airport board and My Flights -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FlightInfo.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_xs"
    android:layout_marginBottom="@dimen/space_xs"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.android.volley.toolbox.NetworkImageView
            android:id="@+id/flight_logo"
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:contentDescription="@string/content_airline_logo"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/flight_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.FlightInfo.Code"
                tools:text="VN215" />

            <TextView
                android:id="@+id/flight_airline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/text_caption"
                tools:text="Vietnam Airlines" />

            <TextView
                android:id="@+id/flight_route"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body"
                tools:text="HAN → SGN" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/flight_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.FlightInfo.Code"
                tools:text="11:35" />

            <TextView
                android:id="@+id/flight_time_old"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/text_caption"
                android:visibility="gone"
                tools:text="11:00"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/flight_status"
                style="@style/Widget.FlightInfo.StatusChip"
                android:layout_marginTop="@dimen/space_xs"
                tools:text="On time" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
