<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.FlightInfo.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <TextView
        android:id="@+id/mock_banner"
        style="@style/Widget.FlightInfo.Banner" />

    <!-- Glass segmented switch for the ViewPager2 below, linked with TabLayoutMediator -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/board_tabs"
        style="@style/Widget.FlightInfo.Tabs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_xs" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/board_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
