<?xml version="1.0" encoding="utf-8"?>
<!-- Content scrolls under a floating glass tab bar. BlurTarget records the content once on the
     render thread, and BlurView blurs that recording behind the bar (Android 12+).
     <merge>: the activity's content FrameLayout is the parent, no extra layout level. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blur_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Widget.FlightInfo.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="@string/app_name" />

            <TextView
                android:id="@+id/mock_banner"
                style="@style/Widget.FlightInfo.Banner" />

            <!-- One fragment per bottom tab; tabs are shown/hidden so each keeps its state -->
            <FrameLayout
                android:id="@+id/fragment_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </eightbitlab.com.blurview.BlurTarget>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_bar_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/nav_bar_margin"
        android:layout_marginEnd="@dimen/nav_bar_margin"
        android:layout_marginBottom="@dimen/nav_bar_margin_bottom"
        android:background="@drawable/bg_nav_bar"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            style="@style/Widget.FlightInfo.BottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            app:menu="@menu/menu_bottom_nav" />
    </eightbitlab.com.blurview.BlurView>

</merge>
