<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/auth_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/auth_screen_gutter"
            android:paddingEnd="@dimen/auth_screen_gutter"
            android:paddingTop="@dimen/space_l"
            android:paddingBottom="@dimen/space_xl">
            <LinearLayout
                android:id="@+id/auth_form"
                style="@style/Widget.FlightInfo.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">
                <ImageView
                    android:layout_width="@dimen/logo_size_large"
                    android:layout_height="@dimen/logo_size_large"
                    android:layout_gravity="center_horizontal"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_launcher_foreground" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center"
                    android:id="@+id/auth_title"
                    android:text="@string/auth_login_title"
                    android:textSize="@dimen/auth_text_title"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center"
                    android:text="@string/auth_login_subtitle"
                    android:textColor="@color/text_secondary" />
                <TextView
                    android:id="@+id/auth_config_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/auth_config_notice"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/auth_email_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/auth_email"
            app:errorEnabled="true">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/auth_password_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/auth_password"
            app:errorEnabled="true" app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:maxLines="1" android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_reset"
            style="@style/Widget.FlightInfo.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/auth_touch_target"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/auth_reset" />
        <ProgressBar
            android:id="@+id/auth_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/auth_loading"
            android:accessibilityLiveRegion="polite"
            android:indeterminate="true"
            android:visibility="invisible" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_submit"
            style="@style/Widget.FlightInfo.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/auth_touch_target"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/auth_sign_in" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_register"
            style="@style/Widget.FlightInfo.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/auth_touch_target"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/auth_create_account" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_guest"
            style="@style/Widget.FlightInfo.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/auth_touch_target"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/auth_continue_guest" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:text="@string/auth_guest_hint"
            android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
