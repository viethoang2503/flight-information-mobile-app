<?xml version="1.0" encoding="utf-8"?>
<!-- No root background: the window background already draws the gradient (overdraw). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/stats_toolbar"
        style="@style/Widget.FlightInfo.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/nav_bar_clearance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_s">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body"
                android:layout_marginBottom="@dimen/space_m" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/stats_flight_count" android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption"/>
                    <TextView android:id="@+id/stats_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        tools:text="0" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/stats_distance" android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption"/>
                    <TextView android:id="@+id/stats_distance_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        tools:text="0 km" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/stats_hours" android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption"/>
                    <TextView android:id="@+id/stats_hours_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        tools:text="0 h" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/stats_on_time" android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption"/>
                    <TextView android:id="@+id/stats_punctuality_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        tools:text="0%" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold"/>
                </LinearLayout>
            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/space_m">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_airlines_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />
                <vn.edu.usth.flightinfo.ui.stats.BarChartView
                    android:id="@+id/stats_airline_chart"
                    android:layout_width="match_parent"
                    android:layout_height="205dp"
                    android:layout_marginTop="@dimen/space_s" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_l">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_busiest_airport_title"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
                <TextView
                    android:id="@+id/stats_busiest_airport_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/stats_value_none"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
