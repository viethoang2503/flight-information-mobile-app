<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.FlightInfo.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <!-- The whole preference list sits on one glass panel: one translucent layer -->
    <FrameLayout
        android:id="@+id/settings_container"
        style="@style/Widget.FlightInfo.Glass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_m"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_s" />

</LinearLayout>
