<?xml version="1.0" encoding="utf-8"?>
<!-- Detail rows (added from code) and the arrival-airport weather card, both on glass -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Widget.FlightInfo.SectionHeader"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/detail_section_info" />

    <LinearLayout
        android:id="@+id/info_container"
        style="@style/Widget.FlightInfo.Glass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="6dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:id="@+id/weather_card"
        style="@style/Widget.FlightInfo.Glass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="@dimen/space_m"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="18dp"
        android:paddingBottom="@dimen/space_m"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/weather_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                tools:text="Weather at Ho Chi Minh City" />

            <TextView
                android:id="@+id/weather_category"
                style="@style/Widget.FlightInfo.StatusChip"
                tools:text="VFR" />
        </LinearLayout>

        <TextView
            android:id="@+id/weather_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?android:attr/textColorPrimary"
            tools:text="32°C · Wind 200° 9 kt · Visibility 6+ mi" />

        <!-- Collapsed to one line; tapping changes its LayoutParams height -->
        <TextView
            android:id="@+id/metar_raw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_glass_inset"
            android:fontFamily="monospace"
            android:paddingStart="10dp"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="10dp"
            android:paddingBottom="@dimen/space_s"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/text_caption"
            tools:text="METAR VVTS 010430Z 20009KT 9999 FEW020 SCT100 32/24 Q1012 NOSIG" />

        <TextView
            android:id="@+id/metar_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/metar_expand_hint"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
